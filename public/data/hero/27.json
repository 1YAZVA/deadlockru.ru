rc=\"https://assets-bucket.deadlock-api.com/assets-api-res/images/hud/core/icon_damage_melee.png\" class=\"inline-attribute MeleeDamage\" alt=\"урон ближнего боя\"/><span class=\"inline-attribute-label MeleeDamage\" style=\"color: #EC9719;\">урон ближнего боя</span> и <span class=\"highlight\">замедляя его</span>, когда окажется рядом.","abilityType":"signature"},{"id":"2366960452","name":"Crimson Slash","nameRu":"Багровое рассечение","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/abilities/yamato/yamato_crimson_slash.png","className":"citadel_ability_healing_slash","description":"Slash enemies in front of you, <span class=\"highlight\">damaging them and slowing their fire rate</span>. If any enemy heroes are hit, you <span class=\"highlight\">heal</span>.","descriptionRu":"Ямато рассекает врагов перед собой, <span class=\"highlight\">нанося им урон и снижая их скорострельность</span>. При попадании по вражеским героям Ямато получает <span class=\"highlight\">лечение</span>.","abilityType":"signature"},{"id":"3319782965","name":"Shadow Transformation","nameRu":"Превращение в тень","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/abilities/yamato/yamato_blinding_steel.png","className":"citadel_ability_infinity_slash","description":"Become infused with Yamato's shadow soul. After an initial <span class=\"highlight\">invincible</span> transformation your <span class=\"highlight\">abilities are refreshed and are 60% faster</span>. You gain <span class=\"highlight\">immunity to negative status effects</span> and have greatly increased <span class=\"highlight\">bullet and spirit resist</span>.<br>When you get a hero kill, you <span class=\"highlight\">heal</span> and the <span class=\"highlight\">duration</span> is extended.","descriptionRu":"Ямато сливается со своей теневой душой. После трансформации, во время которой Ямато <span class=\"highlight\">неуязвима</span>, её <span class=\"highlight\">умения полностью перезаряжаются и ускоряются на 60%</span>. Ямато также получает <span class=\"highlight\">иммунитет к отрицательным эффектам</span>, а ещё у неё значительно увеличивается <span class=\"highlight\">сопротивляемость пулям и спиритизму</span>.<br>Если Ямато убивает героя, она получает <span class=\"highlight\">лечение</span>, а действие умения <span class=\"highlight\">продлевается</span>.","abilityType":"ultimate"},{"id":"2573821048","name":"Knocked off Zipline","nameRu":"Падение с зиплайна","image":"","className":"citadel_ability_zip_line","description":"","abilityType":"innate"},{"id":"1466127517","name":"Jump","nameRu":"Прыжок","image":"","className":"citadel_ability_jump","description":"","abilityType":"innate"},{"id":"2335418656","name":"Slide","nameRu":"Скольжение","image":"","className":"citadel_ability_slide","description":"","abilityType":"innate"},{"id":"875395762","name":"citadel_ability_zipline_boost","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/upgrades/mods_utility/zipline_mastery.png","className":"citadel_ability_zipline_boost","description":"","abilityType":"innate"},{"id":"4109126631","name":"Mantle","nameRu":"Преодоление препятствия","image":"","className":"citadel_ability_mantle","description":"","abilityType":"innate"},{"id":"4261702459","name":"citadel_ability_climb_rope","image":"","className":"citadel_ability_climb_rope","description":"","abilityType":"innate"},{"id":"1443159618","name":"","image":"https://assets-bucket.deadlock-api.com/assets-api-res/icons/hud/icons/icon_speed.svg","className":"citadel_ability_sprint","description":"","abilityType":"innate"},{"id":"2207638101","name":"Dash","nameRu":"Рывок","image":"","className":"citadel_ability_dash","description":"","abilityType":"innate"},{"id":"664285540","name":"Parry","nameRu":"Парирование","image":"","className":"citadel_ability_melee_parry","description":"","abilityType":"innate"}],"updatedAt":"2026-11-16T00:41:20.372Z"}}