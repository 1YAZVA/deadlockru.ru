71725689","matches":31470,"winRate":53.498570066730224,"buyTimeRel":81.00908496675437}]},"abilities":[{"id":"11664367","name":"Melee","nameRu":"Ближний бой","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/abilities/melee_damage.png","className":"citadel_ability_melee_shiv","description":"","abilityType":"melee"},{"id":"2460791803","name":"Serrated Knives","nameRu":"Зазубренные ножи","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/abilities/shiv/shiv_toss.png","className":"citadel_ability_shiv_dagger","description":"Throw a knife that <span class=\"highlight\">bleeds</span> an enemy. Each additional hit adds a <span class=\"highlight\">stack</span> and refreshes the bleed duration, causing the bleed to increase per stack.","descriptionRu":"Заточка бросает кинжал, который вызывает у врага <span class=\"highlight\">кровотечение</span>. Каждое последующее попадание кинжалом добавляет <span class=\"highlight\">единицу этого эффекта</span>, а отсчёт времени его действия начинается заново. Урон от кровотечения увеличивается с каждой добавленной единицей эффекта.","abilityType":"signature"},{"id":"1458044103","name":"Slice and Dice","nameRu":"Режущий рывок","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/abilities/shiv/shiv_flash.png","className":"citadel_ability_shiv_dash","description":"Perform a <span class=\"highlight\">dash forward, damaging enemies along the path</span>. Hit Enemies have their <img src=\"https://assets-bucket.deadlock-api.com/assets-api-res/images/upgrades/property_tech_armor.png\" class=\"inline-attribute SpiritResist\" alt=\"spirit resist\"/><span class=\"inline-attribute-label SpiritResist\" style=\"color: #CE90FF;\">spirit resist</span> reduced. This debuff can stack.","descriptionRu":"Заточка совершает <span class=\"highlight\">рывок вперёд, нанося урон врагам на пути</span>. У поражённых врагов снижается <img src=\"https://assets-bucket.deadlock-api.com/assets-api-res/images/upgrades/property_tech_armor.png\" class=\"inline-attribute SpiritResist\" alt=\"сопротивляемость спиритизму\"/><span class=\"inline-attribute-label SpiritResist\" style=\"color: #CE90FF;\">сопротивляемость спиритизму</span>. Данный эффект накапливается.","abilityType":"signature"},{"id":"1537272748","name":"Bloodletting","nameRu":"Кровопускание","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/abilities/shiv/shiv_bloodletting.png","className":"citadel_ability_shiv_defer_damage","description":"Take only a portion of incoming damage immediately and defer the rest to be taken over time. Activate to <span class=\"highlight\">clear a portion of the deferred damage</span>.","descriptionRu":"Доля урона, получаемого героем, наносится не сразу, а постепенно. Умение можно активировать, чтобы <span class=\"highlight\">отменить получение части отложенного урона</span>.","abilityType":"signature"},{"id":"1835738020","name":"Killing Blow","nameRu":"Добивающий удар","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/abilities/shiv/shiv_killing_blow.png","className":"citadel_ability_shiv_killing_blow","description":"","abilityType":"ultimate"},{"id":"2573821048","name":"Knocked off Zipline","nameRu":"Падение с зиплайна","image":"","className":"citadel_ability_zip_line","description":"","abilityType":"innate"},{"id":"1466127517","name":"Jump","nameRu":"Прыжок","image":"","className":"citadel_ability_jump","description":"","abilityType":"innate"},{"id":"2335418656","name":"Slide","nameRu":"Скольжение","image":"","className":"citadel_ability_slide","description":"","abilityType":"innate"},{"id":"875395762","name":"citadel_ability_zipline_boost","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/upgrades/mods_utility/zipline_mastery.png","className":"citadel_ability_zipline_boost","description":"","abilityType":"innate"},{"id":"4109126631","name":"Mantle","nameRu":"Преодоление препятствия","image":"","className":"citadel_ability_ma