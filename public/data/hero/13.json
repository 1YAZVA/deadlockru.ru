ate":62.16140912805168,"buyTimeRel":76.92333900686867},{"itemId":"3919289022","matches":279907,"winRate":61.831251094113405,"buyTimeRel":78.11452244635215},{"itemId":"3884003354","matches":476261,"winRate":61.6621978285016,"buyTimeRel":79.26737942609181},{"itemId":"2519598785","matches":98631,"winRate":61.131895651468604,"buyTimeRel":79.5466785134718},{"itemId":"2037039379","matches":328253,"winRate":60.91947369864099,"buyTimeRel":82.19338386523026}]},"abilities":[{"id":"3104292528","name":"Melee","nameRu":"Ближний бой","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/abilities/melee_damage.png","className":"ability_melee_haze","description":"","abilityType":"melee"},{"id":"2948410412","name":"Sleep Dagger","nameRu":"Усыпляющий кинжал","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/abilities/haze/haze_sleep_dagger.png","className":"ability_sleep_dagger","description":"Throw a dagger that <span class=\"highlight\">damages</span> and <span class=\"highlight\">sleeps</span> the target. Sleeping targets wake up shortly after being damaged. Throwing a Dagger does not break your invisibility. Sleep Dagger does not interrupt enemies' channeling abilities.","descriptionRu":"Пелена бросает кинжал, который <span class=\"highlight\">наносит урон</span> и <span class=\"highlight\">усыпляет</span> цель. Спящие цели просыпаются вскоре после получения урона. Бросок кинжала не лишает вас невидимости и не прерывает активированные умения врагов.","abilityType":"signature"},{"id":"2414191464","name":"Smoke Bomb","nameRu":"Дымовая шашка","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/abilities/haze/haze_smoke_bomb.png","className":"ability_smoke_bomb","description":"Fade out of sight, becoming <span class=\"highlight\">invisible</span> and gaining <span class=\"highlight\">sprint speed</span>. Attacking removes invisibility, but using items does not. Close enemies can see through your invisibility.","descriptionRu":"Позволяет скрыться благодаря <span class=\"highlight\">невидимости</span> и <span class=\"highlight\">повышению скорости бега</span>. Пелена теряет невидимость, если начинает атаковать, и становится видимой для врагов, подошедших слишком близко. Использование предметов не лишает невидимости.","abilityType":"signature"},{"id":"1080948381","name":"Fixation","nameRu":"Пристальный взгляд","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/abilities/haze/haze_fixation.png","className":"ability_stacking_damage","description":"Shooting a target <span class=\"highlight\">increases your bullet damage on that target</span>. Gain one <span class=\"highlight\">stack</span> per bullet hit, three if the hit is a headshot.","descriptionRu":"Стрельба по цели <span class=\"highlight\">увеличивает ваш урон от пуль по этой цели</span>. Эффект <span class=\"highlight\">суммируется</span>: +3 ед. при попадании в голову, +1 ед. — в другие части тела.","abilityType":"signature"},{"id":"731943444","name":"Bullet Dance","nameRu":"Танец пуль","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/abilities/haze/haze_bullet_flurry.png","className":"ability_bullet_flurry","description":"Enter a flurry, <span class=\"highlight\">firing your weapon</span> at nearby enemies with <span class=\"highlight\">perfect accuracy</span> and added <span class=\"highlight\">Bullet Damage.</span>","descriptionRu":"Пелена входит в кураж и начинает <span class=\"highlight\">стрелять</span> по врагам поблизости с <span class=\"highlight\">идеальной точностью</span>, а также наносит им дополнительный <span class=\"highlight\">урон от пуль</span>.","abilityType":"ultimate"},{"id":"2573821048","name":"Knocked off Zipline","nameRu":"Падение с зиплайна","image":"","className":"citadel_ability_zip_line","description":"","abilityType":"innate"},{"id":"1466127517","name":"Jump","nameRu":"Прыжок","image":"","className":"citadel_ability_jump","description":"","abilityType":"innate"},{"id":"2335418656","name":"Slide","nameRu":"Скольжение","image":"","className":"citadel_ability_slide","description":"","abilityType":"innate"},{"id":"875395762","name":"citadel_ability_zipline_boost","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/upgrades/mods_utility/zipline_mastery.png","className":"citadel_ability_zipline_boost","description":"","abilityType":"innate"},{"id":"4109126631","name":"Mantle","nameRu":"Преодоление препятствия","image":"","className":"citadel_ability_mantle","description":"","abilityType":"innate"},{"id":"4261702459","name":"citadel_ability_climb_rope","image":"","className":"citadel_ability_climb_rope","description":"","abilityType":"innate"},{"id":"1443159618","name":"","image":"https://assets-bucket.deadlock-api.com/assets-api-res/icons/hud/icons/icon_speed.svg","className":"citadel_ability_sprint","description":"","abilityType":"innate"},{"id":"2207638101","name":"Dash","nameRu":"Рывок","image":"","className":"citadel_ability_dash","description":"","abilityType":"innate"},{"id":"664285540","name":"Parry","nameRu":"Парирование","image":"","className":"citadel_ability_melee_parry","description":"","abilityType":"innate"}],"updatedAt":"2026-11-15T20:33:16.696Z"}}