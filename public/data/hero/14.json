> <span class=\"highlight_courage\">урон</span> и накладывают <Panel class=\"AbilityPropertyIcon prop_slow\"> <span class=\"highlight\">затухающее замедление</span>. Этот эффект срабатывает, только когда не перезаряжается. <br><br>Перезарядка ускоряется на 50% при попадании по всем, кроме героев. <br><span class=\"diminish\">Урон этого умения не зависит от расстояния до жертвы и не применяется к ключевым целям.</span>","abilityType":"signature"},{"id":"2573821048","name":"Knocked off Zipline","nameRu":"Падение с зиплайна","image":"","className":"citadel_ability_zip_line","description":"","abilityType":"innate"},{"id":"1466127517","name":"Jump","nameRu":"Прыжок","image":"","className":"citadel_ability_jump","description":"","abilityType":"innate"},{"id":"2335418656","name":"Slide","nameRu":"Скольжение","image":"","className":"citadel_ability_slide","description":"","abilityType":"innate"},{"id":"875395762","name":"citadel_ability_zipline_boost","image":"https://assets-bucket.deadlock-api.com/assets-api-res/images/upgrades/mods_utility/zipline_mastery.png","className":"citadel_ability_zipline_boost","description":"","abilityType":"innate"},{"id":"4109126631","name":"Mantle","nameRu":"Преодоление препятствия","image":"","className":"citadel_ability_mantle","description":"","abilityType":"innate"},{"id":"4261702459","name":"citadel_ability_climb_rope","image":"","className":"citadel_ability_climb_rope","description":"","abilityType":"innate"},{"id":"1443159618","name":"","image":"https://assets-bucket.deadlock-api.com/assets-api-res/icons/hud/icons/icon_speed.svg","className":"citadel_ability_sprint","description":"","abilityType":"innate"},{"id":"2207638101","name":"Dash","nameRu":"Рывок","image":"","className":"citadel_ability_dash","description":"","abilityType":"innate"},{"id":"664285540","name":"Parry","nameRu":"Парирование","image":"","className":"citadel_ability_melee_parry","description":"","abilityType":"innate"}],"updatedAt":"2026-11-15T20:33:16.913Z"}}